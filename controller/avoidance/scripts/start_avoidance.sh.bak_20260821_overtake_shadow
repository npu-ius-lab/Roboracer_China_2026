#!/usr/bin/env bash
set -euo pipefail

AVOIDANCE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MPCC_ROOT="$(cd "$AVOIDANCE_DIR/.." && pwd)"
PERCEPTION_WS="${PERCEPTION_WS:-/home/tianbot/perception}"
RACELINE="${AVOIDANCE_RACELINE:-$MPCC_ROOT/src/f1tenth_dynamic_mpcc/data/tracks/racelinev3/raceline.csv}"
LOG_DIR="$AVOIDANCE_DIR/log"
PID_FILE="$LOG_DIR/avoidance.pid"
MODE="${1:---background}"
START_PERCEPTION=true
if [[ "${2:-}" == "--no-perception" || "${AVOIDANCE_START_PERCEPTION:-true}" == "false" ]]; then
  START_PERCEPTION=false
fi

RESTORE_NOUNSET=false
case "$-" in
  *u*) RESTORE_NOUNSET=true ;;
esac
set +u
source /opt/ros/noetic/setup.bash
if [[ "$RESTORE_NOUNSET" == "true" ]]; then
  set -u
fi
unset RESTORE_NOUNSET
export PYTHONPATH="$AVOIDANCE_DIR/python:$PERCEPTION_WS/devel/lib/python3/dist-packages${PYTHONPATH:+:$PYTHONPATH}"

check_files() {
  local required=(
    "$RACELINE"
    "$AVOIDANCE_DIR/python/f1tenth_overtake/__init__.py"
    "$AVOIDANCE_DIR/python/f1tenth_overtake/core.py"
    "$AVOIDANCE_DIR/python/f1tenth_overtake/track.py"
    "$AVOIDANCE_DIR/python/f1tenth_overtake/state_machine.py"
    "$AVOIDANCE_DIR/scripts/overtake_shadow_node.py"
    "$AVOIDANCE_DIR/scripts/avoidance_state_visualizer.py"
    "$AVOIDANCE_DIR/config/overtake_hardware.yaml"
    "$AVOIDANCE_DIR/config/state_visualizer.yaml"
  )
  local path
  for path in "${required[@]}"; do
    if [[ ! -f "$path" ]]; then
      echo "[FAIL] missing avoidance file: $path" >&2
      return 1
    fi
  done
  if grep -R -nE 'AckermannDrive|/tianracer/ackermann_cmd|ackermann_cmd_stamped' \
      "$AVOIDANCE_DIR/scripts"/*.py >/tmp/avoidance_forbidden_topics.txt; then
    echo "[FAIL] avoidance Python code contains a vehicle command interface:" >&2
    sed -n '1,20p' /tmp/avoidance_forbidden_topics.txt >&2
    return 1
  fi
  python3 -m py_compile \
    "$AVOIDANCE_DIR/python/f1tenth_overtake/"*.py \
    "$AVOIDANCE_DIR/scripts/overtake_shadow_node.py" \
    "$AVOIDANCE_DIR/scripts/avoidance_state_visualizer.py" \
    "$AVOIDANCE_DIR/scripts/offline_scan_target_adapter.py" \
    "$AVOIDANCE_DIR/scripts/bag_test_observer.py"
  python3 -c 'from f1tenth_overtake import OvertakePlanner, PeriodicTrack; from f1tenth_overtake.state_machine import OvertakeStateMachine; from opponent_perception.msg import TargetArray; print("[OK] Python modules and TargetArray interface import")'
  python3 -c 'from f1tenth_overtake import PeriodicTrack; import sys; t=PeriodicTrack.from_csv(sys.argv[1]); print("[OK] raceline length=%.3fm samples=%d"%(t.length,len(t.s)))' "$RACELINE"
  echo "[OK] avoidance is shadow-only; no command publisher is present"
}

stop_running() {
  if [[ -f "$PID_FILE" ]]; then
    local pid
    pid="$(sed -n '1p' "$PID_FILE")"
    if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
      kill -INT "$pid" 2>/dev/null || true
      for _ in {1..30}; do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.1
      done
    fi
    unlink "$PID_FILE" 2>/dev/null || true
  fi
}

if [[ "$MODE" == "--check-only" ]]; then
  check_files
  exit 0
elif [[ "$MODE" == "--stop" ]]; then
  stop_running
  exit 0
elif [[ "$MODE" == "--background" ]]; then
  check_files
  mkdir -p "$LOG_DIR"
  if [[ -f "$PID_FILE" ]] && kill -0 "$(sed -n '1p' "$PID_FILE")" 2>/dev/null; then
    echo "[OK] avoidance already running pid=$(sed -n '1p' "$PID_FILE")"
    exit 0
  fi
  STAMP="$(date +%Y%m%d_%H%M%S)"
  BACKGROUND_ARGS=(--foreground)
  if [[ "$START_PERCEPTION" == "false" ]]; then
    BACKGROUND_ARGS+=(--no-perception)
  fi
  nohup "$0" "${BACKGROUND_ARGS[@]}" >"$LOG_DIR/avoidance_${STAMP}.log" 2>&1 &
  echo "$!" >"$PID_FILE"
  echo "[OK] avoidance shadow module started pid=$! log=$LOG_DIR/avoidance_${STAMP}.log"
  exit 0
elif [[ "$MODE" != "--foreground" ]]; then
  echo "usage: $0 [--check-only|--foreground [--no-perception]|--background|--stop]" >&2
  exit 2
fi

check_files
mkdir -p "$LOG_DIR"

if rosnode list 2>/dev/null | grep -qx '/overtake_shadow'; then
  echo "[FAIL] /overtake_shadow is already running" >&2
  exit 1
fi
if rosnode list 2>/dev/null | grep -qx '/avoidance_state_visualizer'; then
  echo "[FAIL] /avoidance_state_visualizer is already running" >&2
  exit 1
fi

PIDS=()
PERCEPTION_STARTED=false
cleanup() {
  local pid
  for pid in "${PIDS[@]}"; do
    kill -INT "$pid" 2>/dev/null || true
  done
  wait "${PIDS[@]}" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

if [[ "$START_PERCEPTION" == "true" ]]; then
  if rosnode list 2>/dev/null | grep -qx '/opponent_perception'; then
    echo "[avoidance] reusing /opponent_perception"
  else
    "$PERCEPTION_WS/start_perception_car.sh" &
    PIDS+=("$!")
    PERCEPTION_STARTED=true
    echo "[avoidance] started existing MID360 opponent perception"
  fi
fi

rosparam load "$AVOIDANCE_DIR/config/overtake_hardware.yaml" /overtake_shadow
rosparam set /overtake_shadow/raceline_csv "$RACELINE"
rosparam load "$AVOIDANCE_DIR/config/state_visualizer.yaml" /avoidance_state_visualizer
rosparam set /avoidance_state_visualizer/raceline_csv "$RACELINE"

python3 "$AVOIDANCE_DIR/scripts/overtake_shadow_node.py" __name:=overtake_shadow &
PIDS+=("$!")
python3 "$AVOIDANCE_DIR/scripts/avoidance_state_visualizer.py" __name:=avoidance_state_visualizer &
PIDS+=("$!")

echo "[avoidance] shadow planner and state visualizer started"
echo "[avoidance] outputs: /avoidance/status /avoidance/decision /avoidance/markers /avoidance/local_plan_red"
echo "[avoidance] command_authority=false"

wait -n "${PIDS[@]}"
echo "[FAIL] one avoidance process exited" >&2
exit 1
