Panels:
  - Class: rviz/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Avoidance1
      Splitter Ratio: 0.56
    Tree Height: 820
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Preferences:
  PromptSaveOnExit: false
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Group
      Displays:
        - Alpha: 0.55
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz/PointCloud2
          Color: 255; 180; 0
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Invert Rainbow: false
          Max Color: 255; 255; 255
          Min Color: 0; 0; 0
          Name: MID360 obstacle cloud
          Position Transformer: XYZ
          Queue Size: 3
          Selectable: true
          Size (Pixels): 3
          Size (m): 0.025
          Style: Points
          Topic: /perception/obstacle_cloud
          Unreliable: false
          Use Fixed Frame: true
          Use rainbow: true
          Value: true
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /perception/target_markers
          Name: 3D perception target boxes
          Queue Size: 10
          Value: true
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /avoidance/track_markers
          Name: Track corridor
          Namespaces:
            left_boundary: true
            raceline: true
            right_boundary: true
          Queue Size: 10
          Value: true
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /avoidance/markers
          Name: Classified obstacles and decision
          Namespaces:
            avoidance_decision: true
            classified_obstacles: true
            ego_vehicle: true
            obstacle_labels: true
            red_local_plan: true
          Queue Size: 10
          Value: true
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /overtake/markers
          Name: Candidate corridors
          Queue Size: 10
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz/Path
          Color: 255; 0; 0
          Enabled: true
          Head Diameter: 0.12
          Head Length: 0.08
          Length: 0.18
          Line Style: Lines
          Line Width: 0.075
          Name: Red local overtake plan
          Offset:
            X: 0
            Y: 0
            Z: 0.08
          Pose Color: 255; 0; 0
          Pose Style: None
          Radius: 0.03
          Shaft Diameter: 0.04
          Shaft Length: 0.08
          Topic: /avoidance/local_plan_red
          Unreliable: false
          Value: true
        - Class: rviz/Odometry
          Enabled: true
          Keep: 1
          Name: Ego pose
          Position Tolerance: 0.001
          Angle Tolerance: 0.01
          Shape:
            Alpha: 1
            Axes Length: 0.6
            Axes Radius: 0.05
            Color: 0; 190; 255
            Head Length: 0.25
            Head Radius: 0.10
            Shaft Length: 0.45
            Shaft Radius: 0.05
            Value: Arrow
          Topic: /localization/vehicle_odom
          Unreliable: false
          Value: true
      Enabled: true
      Name: Avoidance
  Enabled: true
  Global Options:
    Background Color: 20; 20; 24
    Default Light: true
    Fixed Frame: map
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 24
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Field of View: 0.7854
      Focal Point:
        X: 0
        Y: 5.4
        Z: 0
      Focal Shape Fixed Size: false
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 1.5698
      Target Frame: <Fixed Frame>
      Yaw: 3.14159
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 980
  Hide Left Dock: false
  Hide Right Dock: true
  Width: 1600
  X: 120
  Y: 70
