<?xml version="1.0"?>
<launch>
  <!-- A stationary opponent 3 m ahead is generated by the existing C++
       planner smoke fixture. No production planner parameter is relaxed. -->
  <node pkg="f1tenth_dynamic_mpcc" type="v5_jubu_local_planner_cpp"
        name="roboracer_h2h_faststart_static_planner" output="screen" required="true">
    <rosparam command="load"
              file="$(find f1tenth_dynamic_mpcc)/config/candidates/stable_roboracer_h2h_faststart/cpp_runtime.yaml"/>
    <param name="controller_config"
           value="$(find f1tenth_dynamic_mpcc)/config/candidates/stable_roboracer/controller.yaml"/>
    <param name="vehicle_config"
           value="$(find f1tenth_dynamic_mpcc)/config/vehicle_stable_v3_racelineV3.yaml"/>
    <param name="track_csv"
           value="$(find f1tenth_dynamic_mpcc)/data/tracks/raceline_smooth/raceline.csv"/>
    <param name="topics/odom" value="/v5_jubu_smoke/odom"/>
    <param name="topics/roi_cloud" value="/v5_jubu_smoke/roi_cloud"/>
    <param name="topics/local_reference" value="/v5_jubu_smoke/local_reference"/>
    <param name="topics/candidate_left" value="/v5_jubu_smoke/candidate_left"/>
    <param name="topics/candidate_right" value="/v5_jubu_smoke/candidate_right"/>
    <param name="topics/selected_path" value="/v5_jubu_smoke/selected_path"/>
    <param name="topics/valid_area" value="/v5_jubu_smoke/valid_area"/>
    <param name="topics/health" value="/v5_jubu_smoke/health"/>
    <param name="topics/speed_cap" value="/v5_jubu_smoke/speed_cap"/>
    <param name="topics/state" value="/v5_jubu_smoke/state"/>
    <param name="topics/status" value="/v5_jubu_smoke/status"/>
    <param name="topics/diagnostics" value="/v5_jubu_smoke/diagnostics"/>
    <!-- The reusable smoke fixture publishes a body-frame cloud.  Production
         uses raw_body_leveled; only the synthetic input frame is remapped. -->
    <param name="frames/roi_primary" value="body"/>
    <param name="frames/roi_secondary" value="body"/>
  </node>

  <test test-name="roboracer_h2h_faststart_static"
        pkg="f1tenth_dynamic_mpcc" type="v5_jubu_planner_smoke_test"
        time-limit="15.0">
    <param name="track_csv"
           value="$(find f1tenth_dynamic_mpcc)/data/tracks/raceline_smooth/raceline.csv"/>
    <!-- Wide, low-curvature production-track segment. -->
    <param name="track_s" value="20.50"/>
  </test>
</launch>
