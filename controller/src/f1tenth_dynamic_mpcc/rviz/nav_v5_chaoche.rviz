Panels:
  - Class: rviz/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Navigation1
      Splitter Ratio: 0.58
    Tree Height: 900
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Expanded:
      - /Measure1
    Name: Tool Properties
    Splitter Ratio: 0.5
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Preferences:
  PromptSaveOnExit: true
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Group
      Displays:
        - Class: rviz/Odometry
          Enabled: true
          Keep: 1
          Name: Localization vehicle pose
          Position Tolerance: 0.001
          Angle Tolerance: 0.01
          Shape:
            Alpha: 1
            Axes Length: 0.8
            Axes Radius: 0.08
            Color: 255; 25; 0
            Head Length: 0.3
            Head Radius: 0.12
            Shaft Length: 0.6
            Shaft Radius: 0.06
            Value: Arrow
          Topic: /localization/vehicle_odom
          Unreliable: false
          Value: true
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /f1tenth_mpcc/markers
          Name: MPCC raceline and track corridor
          Namespaces:
            f1tenth_dynamic_mpcc: true
          Queue Size: 100
          Value: true
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /f1tenth_mpcc/prediction
          Name: MPCC predicted trajectory
          Namespaces:
            f1tenth_dynamic_mpcc: true
          Queue Size: 2
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz/Path
          Color: 255; 0; 0
          Enabled: true
          Head Diameter: 0.12
          Head Length: 0.08
          Length: 0.30
          Line Style: Lines
          Line Width: 0.08
          Name: V5 Chaoche local MPCC reference (RED)
          Offset:
            X: 0
            Y: 0
            Z: 0.08
          Pose Color: 255; 0; 0
          Pose Style: None
          Radius: 0.03
          Shaft Diameter: 0.04
          Shaft Length: 0.10
          Topic: /v5_chaoche/local_plan_red
          Unreliable: false
          Value: true
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /v5_chaoche/avoidance/markers
          Name: V5 Chaoche obstacles and state
          Queue Size: 10
          Value: true
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /v5_chaoche/perception/target_markers
          Name: MID360 opponent detections
          Queue Size: 10
          Value: true
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /f1tenth_mpcc/lap_timer/markers
          Name: Lap timer and timing line
          Namespaces:
            f1tenth_lap_timer: true
          Queue Size: 10
          Value: true
      Enabled: true
      Name: Navigation
    - Class: rviz/Group
      Displays:
        - Alpha: 0.3
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: X
          Channel Name: intensity
          Class: rviz/PointCloud2
          Color: 255; 255; 255
          Color Transformer: AxisColor
          Decay Time: 0
          Enabled: true
          Invert Rainbow: false
          Max Color: 255; 255; 255
          Min Color: 0; 0; 0
          Name: Prior map
          Position Transformer: XYZ
          Queue Size: 10
          Selectable: true
          Size (Pixels): 3
          Size (m): 0.01
          Style: Flat Squares
          Topic: /localization/prior_map
          Unreliable: false
          Use Fixed Frame: true
          Use rainbow: true
          Value: true
        - Alpha: 0.85
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz/PointCloud2
          Color: 255; 255; 0
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Invert Rainbow: false
          Max Color: 255; 255; 255
          Min Color: 0; 0; 0
          Name: Aligned MID360 scan
          Position Transformer: XYZ
          Queue Size: 10
          Selectable: true
          Size (Pixels): 3
          Size (m): 0.02
          Style: Squares
          Topic: /localization/aligned_scan
          Unreliable: false
          Use Fixed Frame: true
          Use rainbow: true
          Value: true
      Enabled: true
      Name: Localization point clouds
    - Class: rviz/TF
      Enabled: true
      Filter (blacklist): ""
      Filter (whitelist): ""
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Alpha: 1
      Marker Scale: 1
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Value: true
  Enabled: true
  Global Options:
    Background Color: 24; 24; 28
    Default Light: true
    Fixed Frame: map
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 30
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Field of View: 0.7854
      Focal Point:
        X: 6.6
        Y: -0.84
        Z: 0
      Focal Shape Fixed Size: false
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 1.5698
      Target Frame: <Fixed Frame>
      Yaw: 3.2454
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 1200
  Hide Left Dock: false
  Hide Right Dock: true
  Width: 1920
  X: 80
  Y: 50
