<?xml version="1.0"?>
<package format="2">
  <name>f1tenth_dynamic_mpcc</name>
  <version>0.1.0</version>
  <description>Independent Dynamic MPCC controller for the TianRacer F1TENTH vehicle.</description>
  <maintainer email="tianbot@example.com">tianbot</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>ackermann_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>roscpp</depend>
  <depend>roslib</depend>
  <depend>sensor_msgs</depend>
  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>visualization_msgs</depend>
  <depend>f1tenth_residual_dynamics</depend>
  <build_depend>eigen</build_depend>
  <depend>yaml-cpp</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
</package>
