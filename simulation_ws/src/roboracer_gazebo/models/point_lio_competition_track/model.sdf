<?xml version="1.0"?>
<sdf version="1.6">
  <model name="point_lio_competition_track">
    <static>true</static>

    <!-- The floor covers the complete 615 x 403 map at 0.05 m/cell. -->
    <link name="floor_link">
      <pose>0.157548 6.952436 -0.025 0 0 0</pose>
      <collision name="floor_collision">
        <geometry>
          <box>
            <size>30.75 20.15 0.05</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.4</mu>
              <mu2>1.4</mu2>
            </ode>
          </friction>
          <contact>
            <collide_bitmask>65535</collide_bitmask>
          </contact>
        </surface>
      </collision>
      <visual name="floor_visual">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <box>
            <size>30.75 20.15 0.05</size>
          </box>
        </geometry>
        <material>
          <ambient>0.62 0.62 0.62 1</ambient>
          <diffuse>0.72 0.72 0.72 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>
    </link>

    <!-- Vertices are already expressed in the Point-LIO map/world frame. -->
    <link name="walls_link">
      <collision name="walls_collision">
        <geometry>
          <mesh>
            <uri>model://point_lio_competition_track/meshes/walls.obj</uri>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.9</mu>
              <mu2>0.9</mu2>
            </ode>
          </friction>
          <contact>
            <collide_bitmask>65535</collide_bitmask>
            <ode>
              <kp>1000000</kp>
              <kd>10</kd>
              <max_vel>0.1</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="walls_visual">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <mesh>
            <uri>model://point_lio_competition_track/meshes/walls.obj</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.34 0.34 0.34 1</ambient>
          <diffuse>0.42 0.42 0.42 1</diffuse>
          <specular>0.04 0.04 0.04 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
