<launch>
  <!-- PointLIO frontend for Livox Mid360. -->
  <arg name="rviz" default="true" />
  <arg name="tf_child_frame" default="body" />
  <arg name="tf_child_to_body_x_m" default="0.0" />
  <arg name="tf_child_to_body_y_m" default="0.0" />
  <arg name="tf_child_to_body_z_m" default="0.0" />
  <!-- Local map backend rollback switch: "ivox" or "octvox". -->
  <arg name="local_map_backend" default="ivox" />
  <!-- Localization mode disables world clouds and enables the body cloud. -->
  <arg name="scan_world_publish_en" default="true" />
  <arg name="scan_world_downsample_publish_en" default="true" />
  <arg name="scan_bodyframe_pub_en" default="false" />

  <node pkg="point_lio" type="pointlio_mapping" name="laserMapping" output="screen">
    <rosparam command="load" file="$(find point_lio)/config/mid360.yaml" />
    <param name="mapping/local_map_backend" value="$(arg local_map_backend)" />
    <param name="publish/scan_world_publish_en"
           value="$(arg scan_world_publish_en)" />
    <param name="publish/scan_world_downsample_publish_en"
           value="$(arg scan_world_downsample_publish_en)" />
    <param name="publish/scan_bodyframe_pub_en"
           value="$(arg scan_bodyframe_pub_en)" />
    <param name="use_imu_as_input" type="bool" value="false" />
    <param name="prop_at_freq_of_imu" type="bool" value="true" />
    <param name="check_satu" type="bool" value="true" />
    <param name="init_map_size" type="int" value="10" />
    <param name="point_filter_num" type="int" value="1" />
    <param name="space_down_sample" type="bool" value="true" />
    <param name="filter_size_surf" type="double" value="0.7" />
    <param name="filter_size_map" type="double" value="0.4" />
    <param name="ivox_nearby_type" type="int" value="6" />
    <param name="runtime_pos_log_enable" type="bool" value="false" />
    <param name="odometry/tf_child_frame" value="$(arg tf_child_frame)" />
    <param name="odometry/tf_child_to_body_x_m"
           value="$(arg tf_child_to_body_x_m)" />
    <param name="odometry/tf_child_to_body_y_m"
           value="$(arg tf_child_to_body_y_m)" />
    <param name="odometry/tf_child_to_body_z_m"
           value="$(arg tf_child_to_body_z_m)" />
  </node>

  <group if="$(arg rviz)">
    <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz"
          args="-d $(find point_lio)/rviz_cfg/loam_livox.rviz" />
  </group>
</launch>
